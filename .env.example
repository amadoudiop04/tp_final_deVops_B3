# HTTP_PORT=8081
# APP_VERSION=staging
# POSTGRES_DB=shoplite_staging
# POSTGRES_USER=shoplite_staging
# POSTGRES_PASSWORD=shoplite_staging_password
# DATABASE_URL=postgres://shoplite_staging:shoplite_staging_password@db:5432/shoplite_staging

